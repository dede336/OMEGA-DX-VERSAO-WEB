# Required by the backend
DATABASE_URL=postgresql://user:password@localhost:5432/omega_dx10
SESSION_SECRET=replace-with-a-long-random-value

# Optional seed credentials for the sanitized transfer copy
SEED_ADMIN_PASSWORD=choose-a-local-admin-password
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Optional: public base URL of the API, including /api.
# Set this when the web/mobile app and API are deployed on different domains.
EXPO_PUBLIC_API_URL=https://your-api-domain.example/api
