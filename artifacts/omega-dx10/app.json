{
  "expo": {
    "name": "OMEGA DX10",
    "slug": "omega-dx10",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-icon.png",
    "scheme": "omega-dx10",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/android-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060b14"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "icon": "./assets/images/android-icon.png",
      "backgroundColor": "#060b14",
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.omegadx10.app"
    },
    "web": {
      "favicon": "./assets/images/browser-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Silkscreen_400Regular.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
